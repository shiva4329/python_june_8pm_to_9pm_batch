   "source": [
    "import pandas as pd\n",
    "d = pd.read_csv(\"employees.csv\")\n",
    "\n",
    "# Sample 25% of the data\n",
    "sr = d.sample(frac=0.25)\n",
    "\n",
    "# Verify the number of rows\n",
    "print(f\"Original rows: {len(d)}\")\n",
    "print(f\"Sampled rows (25%): {len(sr)}\")\n",
    "\n",
    "# Display the result\n",
    "sr\n",
    "\n",
    "sr.columns\n",
    "\n",
    "sr.info()"
   ]
  }
 ],
